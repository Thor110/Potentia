sieve-filter-v2
; Near an anchor: a unit of 32 symbols within so many substitutions of one of these
; anchors (Hamming distance), for searching the space around known content:
;   "it was the best of times it was "
; The state is the place in the unit and the substitutions so far: 1 + p * (distance + 1) + m;
; state 0 is the end of the unit, reached only by a unit of the anchor's length.
; Made by tools/build_anchor_plugins.py from anchors-one.txt (sha256 13d178e257f66ee8f3329443f4686350a62c4225eef7b84b86c8f944fac6442f).
id        near-example
version   1
author    Edward James Gordon (written with Claude)
origin    ai-directed
lines     text
symbols   lower27
describe  Within the distance (substitutions) of the anchor "it was the best of times it was ".
param     distance  int  3  0  32  the most substitutions allowed

states    {1 + 32 * (distance + 1)}
start     1
accept    0
for m 0 {distance}
  t {1 + 0 * (distance + 1) + m} "i" {1 + 1 * (distance + 1) + m}
  if {m < distance}
    t {1 + 0 * (distance + 1) + m} " abcdefghjklmnopqrstuvwxyz" {1 + 1 * (distance + 1) + m + 1}
  fi
  t {1 + 1 * (distance + 1) + m} "t" {1 + 2 * (distance + 1) + m}
  if {m < distance}
    t {1 + 1 * (distance + 1) + m} " abcdefghijklmnopqrsuvwxyz" {1 + 2 * (distance + 1) + m + 1}
  fi
  t {1 + 2 * (distance + 1) + m} " " {1 + 3 * (distance + 1) + m}
  if {m < distance}
    t {1 + 2 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" {1 + 3 * (distance + 1) + m + 1}
  fi
  t {1 + 3 * (distance + 1) + m} "w" {1 + 4 * (distance + 1) + m}
  if {m < distance}
    t {1 + 3 * (distance + 1) + m} " abcdefghijklmnopqrstuvxyz" {1 + 4 * (distance + 1) + m + 1}
  fi
  t {1 + 4 * (distance + 1) + m} "a" {1 + 5 * (distance + 1) + m}
  if {m < distance}
    t {1 + 4 * (distance + 1) + m} " bcdefghijklmnopqrstuvwxyz" {1 + 5 * (distance + 1) + m + 1}
  fi
  t {1 + 5 * (distance + 1) + m} "s" {1 + 6 * (distance + 1) + m}
  if {m < distance}
    t {1 + 5 * (distance + 1) + m} " abcdefghijklmnopqrtuvwxyz" {1 + 6 * (distance + 1) + m + 1}
  fi
  t {1 + 6 * (distance + 1) + m} " " {1 + 7 * (distance + 1) + m}
  if {m < distance}
    t {1 + 6 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" {1 + 7 * (distance + 1) + m + 1}
  fi
  t {1 + 7 * (distance + 1) + m} "t" {1 + 8 * (distance + 1) + m}
  if {m < distance}
    t {1 + 7 * (distance + 1) + m} " abcdefghijklmnopqrsuvwxyz" {1 + 8 * (distance + 1) + m + 1}
  fi
  t {1 + 8 * (distance + 1) + m} "h" {1 + 9 * (distance + 1) + m}
  if {m < distance}
    t {1 + 8 * (distance + 1) + m} " abcdefgijklmnopqrstuvwxyz" {1 + 9 * (distance + 1) + m + 1}
  fi
  t {1 + 9 * (distance + 1) + m} "e" {1 + 10 * (distance + 1) + m}
  if {m < distance}
    t {1 + 9 * (distance + 1) + m} " abcdfghijklmnopqrstuvwxyz" {1 + 10 * (distance + 1) + m + 1}
  fi
  t {1 + 10 * (distance + 1) + m} " " {1 + 11 * (distance + 1) + m}
  if {m < distance}
    t {1 + 10 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" {1 + 11 * (distance + 1) + m + 1}
  fi
  t {1 + 11 * (distance + 1) + m} "b" {1 + 12 * (distance + 1) + m}
  if {m < distance}
    t {1 + 11 * (distance + 1) + m} " acdefghijklmnopqrstuvwxyz" {1 + 12 * (distance + 1) + m + 1}
  fi
  t {1 + 12 * (distance + 1) + m} "e" {1 + 13 * (distance + 1) + m}
  if {m < distance}
    t {1 + 12 * (distance + 1) + m} " abcdfghijklmnopqrstuvwxyz" {1 + 13 * (distance + 1) + m + 1}
  fi
  t {1 + 13 * (distance + 1) + m} "s" {1 + 14 * (distance + 1) + m}
  if {m < distance}
    t {1 + 13 * (distance + 1) + m} " abcdefghijklmnopqrtuvwxyz" {1 + 14 * (distance + 1) + m + 1}
  fi
  t {1 + 14 * (distance + 1) + m} "t" {1 + 15 * (distance + 1) + m}
  if {m < distance}
    t {1 + 14 * (distance + 1) + m} " abcdefghijklmnopqrsuvwxyz" {1 + 15 * (distance + 1) + m + 1}
  fi
  t {1 + 15 * (distance + 1) + m} " " {1 + 16 * (distance + 1) + m}
  if {m < distance}
    t {1 + 15 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" {1 + 16 * (distance + 1) + m + 1}
  fi
  t {1 + 16 * (distance + 1) + m} "o" {1 + 17 * (distance + 1) + m}
  if {m < distance}
    t {1 + 16 * (distance + 1) + m} " abcdefghijklmnpqrstuvwxyz" {1 + 17 * (distance + 1) + m + 1}
  fi
  t {1 + 17 * (distance + 1) + m} "f" {1 + 18 * (distance + 1) + m}
  if {m < distance}
    t {1 + 17 * (distance + 1) + m} " abcdeghijklmnopqrstuvwxyz" {1 + 18 * (distance + 1) + m + 1}
  fi
  t {1 + 18 * (distance + 1) + m} " " {1 + 19 * (distance + 1) + m}
  if {m < distance}
    t {1 + 18 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" {1 + 19 * (distance + 1) + m + 1}
  fi
  t {1 + 19 * (distance + 1) + m} "t" {1 + 20 * (distance + 1) + m}
  if {m < distance}
    t {1 + 19 * (distance + 1) + m} " abcdefghijklmnopqrsuvwxyz" {1 + 20 * (distance + 1) + m + 1}
  fi
  t {1 + 20 * (distance + 1) + m} "i" {1 + 21 * (distance + 1) + m}
  if {m < distance}
    t {1 + 20 * (distance + 1) + m} " abcdefghjklmnopqrstuvwxyz" {1 + 21 * (distance + 1) + m + 1}
  fi
  t {1 + 21 * (distance + 1) + m} "m" {1 + 22 * (distance + 1) + m}
  if {m < distance}
    t {1 + 21 * (distance + 1) + m} " abcdefghijklnopqrstuvwxyz" {1 + 22 * (distance + 1) + m + 1}
  fi
  t {1 + 22 * (distance + 1) + m} "e" {1 + 23 * (distance + 1) + m}
  if {m < distance}
    t {1 + 22 * (distance + 1) + m} " abcdfghijklmnopqrstuvwxyz" {1 + 23 * (distance + 1) + m + 1}
  fi
  t {1 + 23 * (distance + 1) + m} "s" {1 + 24 * (distance + 1) + m}
  if {m < distance}
    t {1 + 23 * (distance + 1) + m} " abcdefghijklmnopqrtuvwxyz" {1 + 24 * (distance + 1) + m + 1}
  fi
  t {1 + 24 * (distance + 1) + m} " " {1 + 25 * (distance + 1) + m}
  if {m < distance}
    t {1 + 24 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" {1 + 25 * (distance + 1) + m + 1}
  fi
  t {1 + 25 * (distance + 1) + m} "i" {1 + 26 * (distance + 1) + m}
  if {m < distance}
    t {1 + 25 * (distance + 1) + m} " abcdefghjklmnopqrstuvwxyz" {1 + 26 * (distance + 1) + m + 1}
  fi
  t {1 + 26 * (distance + 1) + m} "t" {1 + 27 * (distance + 1) + m}
  if {m < distance}
    t {1 + 26 * (distance + 1) + m} " abcdefghijklmnopqrsuvwxyz" {1 + 27 * (distance + 1) + m + 1}
  fi
  t {1 + 27 * (distance + 1) + m} " " {1 + 28 * (distance + 1) + m}
  if {m < distance}
    t {1 + 27 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" {1 + 28 * (distance + 1) + m + 1}
  fi
  t {1 + 28 * (distance + 1) + m} "w" {1 + 29 * (distance + 1) + m}
  if {m < distance}
    t {1 + 28 * (distance + 1) + m} " abcdefghijklmnopqrstuvxyz" {1 + 29 * (distance + 1) + m + 1}
  fi
  t {1 + 29 * (distance + 1) + m} "a" {1 + 30 * (distance + 1) + m}
  if {m < distance}
    t {1 + 29 * (distance + 1) + m} " bcdefghijklmnopqrstuvwxyz" {1 + 30 * (distance + 1) + m + 1}
  fi
  t {1 + 30 * (distance + 1) + m} "s" {1 + 31 * (distance + 1) + m}
  if {m < distance}
    t {1 + 30 * (distance + 1) + m} " abcdefghijklmnopqrtuvwxyz" {1 + 31 * (distance + 1) + m + 1}
  fi
  t {1 + 31 * (distance + 1) + m} " " 0
  if {m < distance}
    t {1 + 31 * (distance + 1) + m} "abcdefghijklmnopqrstuvwxyz" 0
  fi
done
end
