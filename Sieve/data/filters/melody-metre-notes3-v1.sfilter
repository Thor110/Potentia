sieve-filter-v2
; melody-metre-v1 for the notes3 family: every note and rest fits inside its bar, none crossing a
; bar line, in ticks: a bar of 2/4 is 2 * TPQ ticks, of 6/8 three eighths (3 * TPQ / 2). With
; `complete`, the last bar is filled too. The state is how many ticks of the bar have gone.
id        melody-metre-notes3
version   1
author    Edward James Gordon (written with Claude)
origin    ai-directed
lines     audio
symbols   notes3*
describe  Notes and rests fit inside bars of the time signature, none across a bar line.
param     time      choice  4-4 2-4,3-4,4-4,5-4,6-8 the time signature
param     complete  choice  no no,yes whether the last bar must be filled

states    {((time == 0) * 2 + (time == 1) * 3 + (time == 2) * 4 + (time == 3) * 5) * TPQ + (time == 4) * 3 * TPQ / 2}
start     0
if {complete == 1}
  accept  0
else
  accept  0..{((time == 0) * 2 + (time == 1) * 3 + (time == 2) * 4 + (time == 3) * 5) * TPQ + (time == 4) * 3 * TPQ / 2 - 1}
fi
for pos 0 {((time == 0) * 2 + (time == 1) * 3 + (time == 2) * 4 + (time == 3) * 5) * TPQ + (time == 4) * 3 * TPQ / 2 - 1}
  for n 1 {min(LONGEST, ((time == 0) * 2 + (time == 1) * 3 + (time == 2) * 4 + (time == 3) * 5) * TPQ + (time == 4) * 3 * TPQ / 2 - pos)}
    t {pos} @{REST(n)} {(pos + n) % (((time == 0) * 2 + (time == 1) * 3 + (time == 2) * 4 + (time == 3) * 5) * TPQ + (time == 4) * 3 * TPQ / 2)}
    for p 1 {PITCHES}
      for k 1 {LEVELS}
        t {pos} @{NOTE(p, k, n)} {(pos + n) % (((time == 0) * 2 + (time == 1) * 3 + (time == 2) * 4 + (time == 3) * 5) * TPQ + (time == 4) * 3 * TPQ / 2)}
      done
    done
  done
done
end
