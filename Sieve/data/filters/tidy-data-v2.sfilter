sieve-filter-v1
; tidy-data-v1, with the built-in max-run-v1 in place of max-run-data-v1: the same rule (no word
; longer than longest letters, and with it clean-data-v1 and no letter run longer than 3), but its
; run rule is the built-in's, which is one automaton on every text alphabet. max-run-data-v1 and
; tidy-data-v1 are retired for it (FILTERS-CONFLICTS.md).
id        tidy-data
version   2
author    Edward James Gordon (written with Claude)
origin    ai-directed
lines     text
symbols   lower27
describe  No word longer than longest letters, and it switches on clean-data-v1 and max-run-v1 (max_run 3) with it.
requires  clean-data-v1
requires  max-run-v1  max_run=3
param     longest  int  20  1  200  longest word allowed, in letters

class     space   " "
class     letter  a-z

; state k: the current word has k letters so far
states    {longest + 1}
start     0
accept    0..{longest}
for k 0 longest
  t   {k}   space   0
done
for k 0 {longest - 1}
  t   {k}   letter  {k + 1}
done
end
