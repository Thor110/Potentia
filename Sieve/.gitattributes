# Pinned data is hashed byte for byte (SHA-256 in the registries and vector files), so Git must
# never convert its line endings, on any platform. This file works from a subfolder too.
data/** -text
tests/*.tsv -text
tests/*.book -text
tests/example_book_*.txt -text

# Windows batch files keep CRLF line endings (cmd needs them for call :labels).
*.bat text eol=crlf
